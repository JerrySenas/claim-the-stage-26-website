+ * Seat layout for "Battle of the Bands" (Basic Education), generated from the
+ * seating workbook (sheet "BOTB SEAT LAYOUT MORE SEATS", form responses of 2026-09/10).
+ *
+ * x / y are grid cells (1 cell = 1 seat). Seat codes match the workbook (e.g. PLA1, GOAO5).
+ * The right-hand Gold block rows K-O reuse the same codes as the centre Gold block
+ * in the workbook, so those 25 seats carry a "-R" suffix here to keep codes unique.
+ */
+
+export type Tier = "VIP" | "PLATINUM" | "GOLD";
+
+export interface LayoutSeat {
+  seatCode: string;
+  tier: Tier;
+  x: number;
+  y: number;
+  label: string;
+}
+
+export const GRID_COLS = 29;
+export const GRID_ROWS = 21;
+
+export const TIER_PRICE: Record<Tier, number> = { VIP: 0, PLATINUM: 250, GOLD: 150 };
+
+/** VIP seats are reserved and cannot be booked online. */
+export const BOOKABLE_TIERS: Tier[] = ["PLATINUM", "GOLD"];
+
+/** Seats already booked and paid (valid, payment-validated form responses). */
